{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoadmapSnap Configuration",
  "description": "Schema for the RoadmapSnap CONFIG object. Validation rules mirror js/core/configValidator.js. WORKFLOW alternation (state/milestone) and first-milestone presence in deliverables are enforced at runtime.",
  "type": "object",
  "required": ["TIMELINE", "WORKFLOW", "DELIVERABLES"],
  "properties": {
    "VERSION": {
      "type": "string",
      "description": "Build or app version string."
    },
    "BUILD_DATE": {
      "type": "string",
      "description": "Build date string."
    },
    "TIMELINE": {
      "type": "object",
      "required": ["START_MONTH", "END_MONTH"],
      "properties": {
        "TODAY": {
          "oneOf": [
            { "type": "string", "const": "" },
            { "type": "string", "pattern": "^(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])/\\d{4}$" }
          ],
          "description": "Current date for 'today' line; DD/MM/YYYY or empty string."
        },
        "START_MONTH": {
          "type": "string",
          "pattern": "^(0?[1-9]|1[0-2])/\\d{4}$",
          "description": "Start of timeline range (MM/YYYY)."
        },
        "END_MONTH": {
          "type": "string",
          "pattern": "^(0?[1-9]|1[0-2])/\\d{4}$",
          "description": "End of timeline range (MM/YYYY)."
        }
      },
      "additionalProperties": false
    },
    "WORKFLOW": {
      "type": "array",
      "minItems": 3,
      "description": "Items must alternate: index 0,2,4,... type 'state'; index 1,3,5,... type 'milestone'. Enforced by configValidator.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "key", "short", "title"],
            "properties": {
              "type": { "const": "state" },
              "key": { "type": "string" },
              "short": { "type": "string", "maxLength": 4 },
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "key", "short", "title"],
            "properties": {
              "type": { "const": "milestone" },
              "key": { "type": "string" },
              "short": { "type": "string", "maxLength": 4 },
              "title": { "type": "string" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "Hex color for milestone." },
              "subtitle": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "ENTITY_LABELS": {
      "type": "object",
      "properties": {
        "singular": { "type": "string" },
        "plural": { "type": "string" },
        "columnHeader": { "type": "string" },
        "scopeLabel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DASHBOARD_TEXT": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "totalSubtitleSuffix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "NON_FILTERABLE_GROUPS": {
      "type": "array",
      "items": { "type": "string" }
    },
    "GROUP_ORDER": {
      "type": "array",
      "items": { "type": "string" }
    },
    "DELIVERABLES": {
      "type": "array",
      "minItems": 1,
      "description": "Deliverable names must be unique (enforced by configValidator). First milestone key from WORKFLOW must appear in each deliverable's milestones.",
      "items": {
        "type": "object",
        "required": ["name", "milestones"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Must be unique across DELIVERABLES."
          },
          "group": { "type": "string" },
          "atRisk": { "type": "boolean", "default": false },
          "descoped": { "type": "boolean", "default": false },
          "showInTimeline": { "type": "boolean", "default": true },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "link": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "type": "string",
            "description": "Legacy: used as START date when milestones.START is absent (getMilestoneDate)."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["task"],
                  "properties": {
                    "task": { "type": "string" },
                    "from": { "type": "string" },
                    "to": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "milestones": {
            "type": "object",
            "description": "Keys are milestone keys (e.g. START, M1); values must be DD/MM/YYYY or empty. First milestone key from WORKFLOW is required.",
            "additionalProperties": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "const": "" },
                { "type": "string", "pattern": "^(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])/\\d{4}$" }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
